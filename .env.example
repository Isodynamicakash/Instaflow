# ─────────────────────────────────────
#  InstaFlow — Environment Variables
# ─────────────────────────────────────

# Instagram Graph API
IG_ACCESS_TOKEN=your_access_token_here
IG_USER_ID=your_ig_user_id_here
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here

# Webhook
IG_WEBHOOK_VERIFY_TOKEN=instaflow_verify_2024

# Anthropic (for LLM features)
ANTHROPIC_API_KEY=your_anthropic_key_here

# WhatsApp (Phase 2)
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=

# Supabase (Phase 2)
# SUPABASE_URL=
# SUPABASE_KEY=

# Server
PORT=8000
ENV=development
